{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":enableVulnerabilityAlerts",
    "security:minimumReleaseAgeCrate",
    ":automergePatch"
  ],
  "labels": [
    "bot",
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Automerge lockfile maintenance after checks pass",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false
    },
    {
      "description": "Group container base image updates",
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "container base images"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Wait three days before updating npm packages",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group non-major JavaScript dependency updates",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "JavaScript dependencies"
    },
    {
      "description": "Group non-major Rust dependency updates",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Rust dependencies"
    },
    {
      "description": "Keep TypeScript below 6.1 until typescript-eslint supports TypeScript 7; typescript-compiler updates independently.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "Group non-major Bun dependencies",
      "matchManagers": [
        "bun"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major Bun dependencies",
      "groupSlug": "all-minor-patch-bun"
    },
    {
      "description": "Group container image updates",
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "helm-values"
      ],
      "groupName": "container images"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on monday"
    ]
  }
}
